# Copy to frontend/.env. Only the backend URL belongs here: everything in a VITE_ variable
# is shipped to every visitor's browser, so no keys and no game content.
VITE_API_URL=http://localhost:8010

# Optional: map tiles for the "OpenStreetMap" map provider (chosen in the admin Map tab).
# Leave unset to use OpenStreetMap's public tiles, which need no key. To use another provider,
# give its {z}/{x}/{y} tile URL here. A key placed in this URL is visible to every visitor, so use
# one restricted to your site's domain.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
