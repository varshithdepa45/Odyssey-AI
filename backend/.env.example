# Copy to backend/.env and fill in. Never commit .env.

ENV=development                      # set to production when deployed
DATABASE_URL=sqlite:///./codehunt.db # local dev; for Supabase use the "Session pooler" URI:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173   # comma-separated frontend origins
TRUST_PROXY=false                    # true on Render, so rate limits see the real client IP

# Secrets. Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ANSWER_PEPPER=                       # changing this later invalidates every stored answer
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Chat model (the Oracle) ----
# none              = free. The Oracle returns the retrieved archive records without an AI summary.
# openai_compatible = any provider with an OpenAI-style /chat/completions endpoint.
# anthropic         = Claude through the Anthropic API (billed separately from a Claude Pro plan).
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4000

# Google Gemini (free tier):  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq (free tier):           AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter (free models):   AI_BASE_URL=https://openrouter.ai/api/v1
# Ollama (local, free):       AI_BASE_URL=http://localhost:11434/v1   (no key needed)
# Anthropic:                  AI_PROVIDER=anthropic, AI_MODEL=claude-opus-5-5 or claude-haiku-5-5
# Pick AI_MODEL from your provider's current model list.

# ---- Embeddings ----
# hash = built in, free, no network. Matches on shared wording, which suits a small archive.
# openai_compatible = an /embeddings endpoint (set the three values below and EMBEDDING_DIM to match).
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=384                    # fixed once the doc_chunks table exists

# ---- Limits ----
SUBMIT_PER_MINUTE=8                  # answer attempts per team
CHAT_PER_MINUTE=6                    # Oracle questions per team
CHAT_DAILY_LIMIT=80                  # Oracle questions per team per 24h; this caps AI spend
LOGIN_PER_MINUTE=10                  # per IP
REGISTER_PER_MINUTE=5                # per IP

AUTO_SEED=true                       # seed placeholder puzzles when the database is empty

# Not set here, because organisers change them from the admin page while the event runs:
# team size, questions per team, event duration, points, hint costs, wrong-answer penalty,
# completion bonus, map provider and markers. They are stored per event in the database.
